{
  "license": "MIT OR Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "tauri": "cargo tauri",
    "postinstall": "cargo install --git https://github.com/tauri-apps/tauri --rev 6f34826405b5908cd5c6fea7f38e33badb69ad54 --locked tauri-cli",
    "predev": "kill-port 3000",
    "dev": "cargo tauri dev --features default",
    "build": "cargo tauri build --no-bundle",
    "ui:dev": "bun run --filter @koharu/bridge build:dev && bun run --parallel --filter '@koharu/*' dev",
    "ui:build": "bun run --filter @koharu/bridge build && bun run --filter @koharu/app build",
    "docs:dev": "cd docs && uvx --from zensical==0.0.43 zensical serve",
    "docs:build": "cd docs && uvx --from zensical==0.0.43 zensical build",
    "lint": "bun run --filter '@koharu/*' lint",
    "test": "bun run --filter @koharu/app test",
    "sponsors": "cd .github/sponsorkit && sponsorkit --force",
    "format": "oxfmt packages tests package.json .oxfmtrc.json .vscode",
    "check": "oxfmt --check packages tests package.json .oxfmtrc.json .vscode"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "git-cliff": "^2.13.1",
    "kill-port": "^2.0.1",
    "oxfmt": "^0.65.0",
    "sponsorkit": "^18.0.0",
    "typescript": "^7.0.2"
  }
}
